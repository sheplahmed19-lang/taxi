NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://ride:ride@localhost:5432/ride_platform
REDIS_URL=redis://localhost:6379

# `prisma migrate dev` needs CREATEDB + the ability to CREATE EXTENSION postgis
# on a throwaway shadow database it spins up itself. Either grant the DB user
# SUPERUSER locally, or set SHADOW_DATABASE_URL to a DB where postgis is
# already installed. `prisma migrate deploy` (used in CI/prod) needs neither.

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rideminio
S3_SECRET_KEY=rideminio123
S3_BUCKET=ride-platform
S3_REGION=us-east-1
